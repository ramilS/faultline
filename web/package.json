{
  "name": "@faultline/web",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('../internal/dashboard/dist/assets',{recursive:true,force:true})\"",
    "build": "tsc --noEmit && npm run clean && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:logic && npm run test:dom",
    "test:logic": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:dom": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.27.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.7",
    "sugar-high": "^1.3.0",
    "tailwind-merge": "^3.6.0",
    "typescript": "5.7.3",
    "vite": "8.1.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.0"
  }
}
