# Host ports published by Docker Compose. Change these if they are already taken.
FAULTLINE_PORT=8080
POSTGRES_PORT=5433

# Replace this value for every non-local deployment.
POSTGRES_PASSWORD=faultline

# Direct process configuration for running the Go binary outside Compose.
FAULTLINE_ADDR=:8080
# Session cookies are secure by default. Set false only for local HTTP development.
FAULTLINE_COOKIE_SECURE=true
DATABASE_URL=postgres://faultline:faultline@localhost:5432/faultline?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_HEALTH_CHECK_PERIOD=1m
SPILL_DIR=./var/spill

# Google Workspace single sign-on. Off unless FAULTLINE_OIDC_CLIENT_ID is set;
# once it is, every other value below is required or the process refuses to
# start. See the README's single-sign-on section, including the manual
# sign-in against real Google required before enabling this in production.
# The OAuth client id from Google Cloud; setting it is what turns SSO on.
#FAULTLINE_OIDC_CLIENT_ID=
# The provider's issuer URL; https, and https://accounts.google.com for Google.
#FAULTLINE_OIDC_ISSUER=https://accounts.google.com
# The OAuth client secret from Google Cloud.
#FAULTLINE_OIDC_CLIENT_SECRET=
# Where Google sends the caller back; must be the redirect URI registered with
# the provider, and https outside localhost.
#FAULTLINE_OIDC_REDIRECT_URL=https://faultline.example.com/api/v1/auth/sso/callback
# Comma-separated Workspace domains, matched exactly against the ID token's hd
# claim -- not the email domain, and never a suffix.
#FAULTLINE_OIDC_ALLOWED_HD=company.com
